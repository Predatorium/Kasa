{
  "source": {
    "include": [
      "src/actions",
      "src/api",
      "src/app",
      "src/components",
      "src/contexts",
      "src/services"
    ],
    "includePattern": ".+\\.(js|jsx)$",
    "excludePattern": "(node_modules|\\.next|\\.module\\.css|action\\.js$)"
  },
  "opts": {
    "destination": "./docs",
    "recurse": true
  },
  "plugins": ["plugins/markdown"]
}